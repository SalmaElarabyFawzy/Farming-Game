:root {
}

.panel {
    background-image: url("project://database/Assets/_Project/Art/Sprites/freeversion.png?fileID=1049408050&guid=7aeddd94609750f42b22dad8dd8c27f8&type=3#freeversion_128");
    -unity-slice-scale: 2.8px;
    width: 880px;
    height: 558px;
    max-width: 880px;
    max-height: 558px;
}

.panel__title {
    font-size: 60px;
    color: rgb(255, 255, 255);
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 10px 60px;
    -unity-text-align: middle-center;
    position: absolute;
    top: 48px;
    right: 34px;
    -unity-font-style: bold;
    width: 200px;
    height: 150px;
    max-width: 200px;
    max-height: 150px;
}

.grid {
    position: absolute;
    top: auto;
    left: 30px;
    right: 30px;
    bottom: 30px;
    flex-direction: row;
    flex-wrap: wrap;
    width: 820px;
    height: 350px;
    max-width: 820px;
    max-height: 255px;
    background-color: rgb(101, 53, 53);
    padding-top: 16px;
    padding-right: 16px;
    padding-bottom: 16px;
    padding-left: 16px;
}

.infoPanel {
    position: absolute;
    left: 50px;
    right: 50px;
    bottom: 50px;
    width: 1820px;
    height: 370px;
    max-height: 370px;
    -unity-slice-scale: 2.8px;
    background-image: url("project://database/Assets/_Project/Art/Sprites/freeversion.png?fileID=1049408050&guid=7aeddd94609750f42b22dad8dd8c27f8&type=3#freeversion_128");
}

.infoPanelTitle {
    top: 50px;
    left: 50px;
    position: absolute;
    width: 200px;
    height: 70px;
    max-width: 200px;
    max-height: 70px;
    font-size: 40px;
    color: rgb(255, 255, 255);
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 10px 50px;
    -unity-text-align: middle-left;
    -unity-font-style: bold;
}

.infoDescription {
    position: absolute;
    width: 1720px;
    height: 170px;
    max-width: 1720px;
    max-height: 170px;
    font-size: 30px;
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 10px 30px;
    background-color: rgb(102, 54, 54);
    color: rgb(255, 255, 255);
    left: 50px;
    right: 50px;
    bottom: 50px;
}

.inventoryBackground {
    color: rgb(255, 255, 255);
    background-color: rgba(255, 255, 255, 0.278);
}

.handSlot {
    position: absolute;
    top: 80px;
    left: 45px;
}
