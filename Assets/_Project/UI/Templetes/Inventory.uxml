            <ui:Instance template="ItemSlot"/>
            <ui:Instance template="ItemSlot"/>
            <ui:Instance template="ItemSlot"/>
            <ui:Instance template="ItemSlot"/>
            <ui:Instance template="ItemSlot"/>
            <ui:Instance template="ItemSlot"/>
            <ui:Instance template="ItemSlot"/>
            <ui:Instance template="ItemSlot"/>
            <ui:Instance template="ItemSlot"/>
            <ui:Instance template="ItemSlot"/>
        </ui:VisualElement>
        <ui:Instance template="ItemSlot" name="handSlot" class="handSlot">
            <AttributeOverrides element-name="quantityLabel" text="" enabled="true"/>
        </ui:Instance>
    </ui:VisualElement>
    <ui:VisualElement name="itemsPanel" class="panel" style="top: 50px; left: auto; position: absolute; right: 50px;">
        <ui:Label text="Items" name="itemsPanelTitle" class="panel__title"/>
        <ui:VisualElement name="grid" class="grid">
            <ui:Instance template="ItemSlot"/>
            <ui:Instance template="ItemSlot"/>
            <ui:Instance template="ItemSlot"/>
            <ui:Instance template="ItemSlot"/>
            <ui:Instance template="ItemSlot"/>
            <ui:Instance template="ItemSlot"/>
