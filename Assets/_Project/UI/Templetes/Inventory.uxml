            <ui:Instance template="ItemSlot"/>
            <ui:Instance template="ItemSlot"/>
            <ui:Instance template="ItemSlot"/>
            <ui:Instance template="ItemSlot"/>
            <ui:Instance template="ItemSlot"/>
            <ui:Instance template="ItemSlot"/>
        </ui:VisualElement>
        <ui:Instance template="ItemSlot" name="handSlot" enabled="true" class="handSlot">
            <AttributeOverrides element-name="quantityLabel" enabled="true" text=""/>
        </ui:Instance>
    </ui:VisualElement>
    <ui:VisualElement name="InfoPanel" class="infoPanel">
        <ui:Label text="" name="itemsName" class="infoPanelTitle"/>
        <ui:Label text="" name="description" class="infoDescription"/>
    </ui:VisualElement>
</ui:UXML>
